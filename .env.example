# Copy to .env and adjust. All variables are optional — these are the defaults.

# Directory holding spool-tracker.db (and its WAL files).
# Default: <repo>/data  (docker-compose sets /data)
#DATA_DIR=

# Port the Express server listens on.
# Default: 8080
#APP_PORT=8080

# Staged-job TTL in days; jobs older than this are pruned at startup.
# Default: 3
STAGED_JOB_TTL_DAYS=3

# Display currency (ISO 4217 code) — frontend display only; stored
# amounts are plain cents. Default: USD
#CURRENCY=USD
